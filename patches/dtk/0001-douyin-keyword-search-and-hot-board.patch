@@ -0,0 +1,276 @@
+"""Keyword search and the hot search board: parsing, request building, wiring.
+
+The result pages are assembled from the ``video_normal`` fixture rather than
+kept as fixtures of their own: the replay fixture set is shared by every
+platform and must stay identical across them (see test_platform_contract).
+"""
+
+from __future__ import annotations
+
+import json
+from copy import deepcopy
+from datetime import UTC, datetime
+from typing import Any
+
+import pytest
+
+from dtk.core.errors import ErrorCode, UnsupportedContent, UpstreamChanged, UpstreamRiskControl
+from dtk.platforms import get_adapter
+from dtk.platforms.douyin import ADAPTER, endpoints, parser
+from dtk.platforms.douyin.params import decode_search_cursor, search_cursor
+from dtk.worker import registry
+from tests.replay.support import FETCHED_AT, load
+
+NORMAL_ID = "7000000000000000001"
+LOGID = "2026092812000001"
+COVER = "https://p3-sign.example-cdn.invalid/hotsearch/alpha.jpeg"
+
+
+def _aweme() -> dict[str, Any]:
+    return deepcopy(load("douyin", "video_normal")["aweme_detail"])
+
+
+def _search_page(**overrides: Any) -> dict[str, Any]:
+    page: dict[str, Any] = {
+        "status_code": 0,
+        "data": [
+            {"type": 1, "aweme_info": _aweme()},
+            {"type": 4, "user_list": [{"user_info": {"nickname": "a user card"}}]},
+            {"type": 16, "aweme_mix_info": {"mix_items": [_aweme()]}},
+        ],
+        "has_more": 1,
+        "cursor": 12,
+        "extra": {"logid": LOGID},
+    }
+    page.update(overrides)
+    return page
+
+
+def _hot_board() -> dict[str, Any]:
+    return {
+        "status_code": 0,
+        "data": {
+            "active_time": "2026-09-28 12:00:00",
+            "word_list": [
+                {
+                    "word": "alpha",
+                    "hot_value": 11813424,
+                    "position": 1,
+                    "label": 3,
+                    "sentence_id": "1690766",
+                    "group_id": "7366000000000000001",
+                    "event_time": 1790582400,
+                    "video_count": 12,
+                    "word_cover": {"url_list": [COVER]},
+                },
+                {"word": "beta", "hot_value": 9000000},
+            ],
+            "trending_list": [{"word": "gamma", "position": 1}],
+        },
+    }
+
+
+# --------------------------------------------------------------------------
+# Search results
+# --------------------------------------------------------------------------
+
+
+def test_search_returns_the_posts_and_skips_other_cards() -> None:
+    page = parser.parse_search(_search_page(), fetched_at=FETCHED_AT)
+
+    assert [item.content_id for item in page.items] == [NORMAL_ID, NORMAL_ID]
+    assert all(item.fetched_at == FETCHED_AT for item in page.items)
+    assert page.has_more is True
+    assert page.cursor == f"12|{LOGID}"
+
+
+def test_the_last_page_has_no_cursor() -> None:
+    page = parser.parse_search(_search_page(has_more=0), fetched_at=FETCHED_AT)
+
+    assert page.has_more is False
+    assert page.cursor is None
+
+
+def test_a_missing_next_offset_advances_by_the_cards_on_the_page() -> None:
+    payload = _search_page()
+    del payload["cursor"]
+
+    page = parser.parse_search(payload, fetched_at=FETCHED_AT, cursor="10|previous")
+
+    assert page.cursor == f"13|{LOGID}"
+
+
+def test_no_results_is_an_empty_page_rather_than_a_schema_change() -> None:
+    page = parser.parse_search({"status_code": 0, "has_more": 0}, fetched_at=FETCHED_AT)
+
+    assert page.items == []
+    assert page.cursor is None
+
+
+def test_a_captcha_demand_is_risk_control() -> None:
+    payload = {
+        "status_code": 0,
+        "data": [],
+        "search_nil_info": {"search_nil_type": parser.SEARCH_VERIFY_CHECK},
+    }
+
+    assert parser.detect_risk_control(payload) == "search_verify_check"
+    with pytest.raises(UpstreamRiskControl):
+        parser.parse_search(payload, fetched_at=FETCHED_AT)
+
+
+def test_a_post_card_missing_its_id_is_reported_not_skipped() -> None:
+    payload = _search_page()
+    del payload["data"][0]["aweme_info"]["aweme_id"]
+
+    with pytest.raises(UpstreamChanged) as excinfo:
+        parser.parse_search(payload, fetched_at=FETCHED_AT)
+    assert excinfo.value.path == "data[0].aweme_info.aweme_id"
+
+
+# --------------------------------------------------------------------------
+# Hot search board
+# --------------------------------------------------------------------------
+
+
+def test_hot_board_entries_keep_rank_heat_and_cover() -> None:
+    board = parser.parse_hot_search(_hot_board())
+
+    assert board.active_time == "2026-09-28 12:00:00"
+    first, second = board.items
+    assert (first.word, first.position, first.hot_value, first.label) == ("alpha", 1, 11813424, 3)
+    assert first.sentence_id == "1690766"
+    assert first.video_count == 12
+    assert first.event_time == datetime(2026, 9, 28, 8, 0, tzinfo=UTC)
+    assert first.cover is not None and first.cover.url == COVER
+    assert (second.word, second.position, second.cover) == ("beta", 2, None)
+    assert [word.word for word in board.trending] == ["gamma"]
+
+
+def test_hot_board_without_its_word_list_is_a_schema_change() -> None:
+    with pytest.raises(UpstreamChanged) as excinfo:
+        parser.parse_hot_search({"status_code": 0, "data": {"active_time": "x"}})
+    assert excinfo.value.path == "data.word_list"
+
+
+# --------------------------------------------------------------------------
+# Request building
+# --------------------------------------------------------------------------
+
+
+def test_cursor_round_trips() -> None:
+    assert decode_search_cursor(search_cursor(15, "abc")) == (15, "abc")
+    assert decode_search_cursor(None) == (0, "")
+    assert decode_search_cursor("30") == (30, "")
+
+
+def test_plain_search_request_is_not_flagged_as_filtered() -> None:
+    spec = ADAPTER.build_request(endpoints.SEARCH, keyword=" camping ")
+
+    assert spec["url"] == "https://www.douyin.com/aweme/v1/web/general/search/single/"
+    params = spec["params"]
+    assert params["keyword"] == "camping"
+    assert (params["offset"], params["search_id"], params["is_filter_search"]) == ("0", "", "0")
+    assert "filter_selected" not in params
+    assert params["aid"] == "6383"
+    assert "a_bogus" not in params
+
+
+def test_sorting_and_time_window_travel_as_one_filter() -> None:
+    spec = ADAPTER.build_request(
+        endpoints.SEARCH,
+        keyword="camping",
+        sort_type=1,
+        publish_time="7",
+        cursor=search_cursor(20, LOGID),
+        count=10,
+    )
+
+    params = spec["params"]
+    assert params["is_filter_search"] == "1"
+    assert json.loads(params["filter_selected"]) == {"sort_type": "1", "publish_time": "7"}
+    assert (params["offset"], params["search_id"], params["count"]) == ("20", LOGID, "10")
+
+
+@pytest.mark.parametrize(
+    "arguments",
+    [
+        {"keyword": "x", "sort_type": 9},
+        {"keyword": "x", "publish_time": 30},
+        {"keyword": "x", "cursor": "not-an-offset|id"},
+        {"keyword": "x", "cursor": "-5|id"},
+    ],
+)
+def test_invalid_search_arguments_are_bad_parameters(arguments: dict[str, Any]) -> None:
+    from dtk.core.errors import DtkError
+
+    with pytest.raises(DtkError) as excinfo:
+        ADAPTER.build_request(endpoints.SEARCH, **arguments)
+    assert excinfo.value.code is ErrorCode.INVALID_PARAM
+
+
+def test_hot_board_request_carries_the_base_parameters_only() -> None:
+    spec = ADAPTER.build_request(endpoints.HOT_SEARCH)
+
+    assert spec["url"] == "https://www.douyin.com/aweme/v1/web/hot/search/list/"
+    assert spec["params"]["device_platform"] == "webapp"
+    assert "keyword" not in spec["params"]
+
+
+# --------------------------------------------------------------------------
+# Registry wiring
+# --------------------------------------------------------------------------
+
+
+def test_search_is_registered_with_its_canonical_parameters() -> None:
+    definition = registry.ENDPOINTS["douyin.search"]
+
+    assert definition.required == (registry.KEYWORD,)
+    assert set(definition.accepts) == {
+        registry.KEYWORD,
+        registry.SORT_TYPE,
+        registry.PUBLISH_TIME,
+        registry.CURSOR,
+        registry.COUNT,
+    }
+    assert definition.cache_ttl_key == "cache.list_ttl"
+    assert "tiktok.search" not in registry.ENDPOINTS
+
+
+def test_the_argumentless_board_is_registered_too() -> None:
+    definition = registry.ENDPOINTS["douyin.hot_search"]
+
+    assert definition.accepts == ()
+    assert definition.required == ()
+    assert definition.canonical_params({"include_raw": True}) == {}
+
+
+def test_search_parses_through_the_registry_with_the_request_cursor() -> None:
+    definition = registry.ENDPOINTS["douyin.search"]
+    payload = _search_page()
+    del payload["cursor"]
+
+    page = definition.parse(payload, params={"keyword": "camping", "cursor": "3|x"})
+
+    assert page.cursor == f"6|{LOGID}"
+    assert definition.platform_params({"keyword": "camping", "count": "10"}) == {
+        "keyword": "camping",
+        "count": 10,
+    }
+
+
+def test_search_rejects_parameters_it_does_not_have() -> None:
+    from dtk.core.errors import DtkError
+
+    with pytest.raises(DtkError) as excinfo:
+        registry.ENDPOINTS["douyin.search"].canonical_params({"keyword": "x", "aweme_id": "1"})
+    assert excinfo.value.code is ErrorCode.INVALID_PARAM
+
+
+def test_tiktok_says_it_has_neither() -> None:
+    adapter = get_adapter("tiktok")
+
+    with pytest.raises(UnsupportedContent):
+        adapter.parse_search({}, fetched_at=FETCHED_AT)
+    with pytest.raises(UnsupportedContent):
+        adapter.parse_hot_search({})
