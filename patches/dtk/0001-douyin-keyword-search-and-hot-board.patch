+def _search_post(entry: Node) -> Node | None:
+    """The post inside one search result card, or None for a card that holds none.
+
+    A results page mixes post cards with user, live-room and topic cards; only
+    the first kind carries ``aweme_info``. A mix card carries its posts under
+    ``aweme_mix_info.mix_items`` and is represented by the first of them.
+    """
+    post = entry.opt_child("aweme_info")
+    if post is not None:
+        return post
+    mix = entry.opt_child("aweme_mix_info")
+    mix_items = mix.opt_children("mix_items") if mix is not None else []
+    return mix_items[0] if mix_items else None
+
+
+def parse_search(
+    payload: Mapping[str, Any], *, fetched_at: datetime, cursor: str | None = None
+) -> Page[Content]:
+    """Parse ``/aweme/v1/web/general/search/single/``.
+
+    ``cursor`` is the one this page was requested with; it is only needed when
+    the platform says there is more but omits the next offset, in which case
+    the offset advances by the number of cards on this page. An empty result
+    arrives without ``data`` at all, which is an empty page rather than a
+    schema change.
+    """
+    root = _guard(payload)
+    entries = root.opt_children("data")
+    posts = [post for post in (_search_post(entry) for entry in entries) if post is not None]
+    items = [content_from_node(post, fetched_at=fetched_at) for post in posts]
+    has_more = optional_bool(root.get("has_more"))
+    if not has_more:
+        return Page(items=items, cursor=None, has_more=False)
+    offset = optional_int(root.get("cursor"))
+    if offset is None:
+        offset = decode_search_cursor(cursor)[0] + len(entries)
+    extra = root.opt_child("extra")
+    search_id = optional_str(extra.get("logid")) if extra is not None else None
+    return Page(items=items, cursor=search_cursor(offset, search_id), has_more=True)
+
+
+def _hot_word(node: Node, index: int) -> HotSearchWord:
+    return HotSearchWord(
+        platform=_PLATFORM,
+        word=node.text("word"),
+        position=optional_positive_int(node.get("position")) or index + 1,
+        hot_value=optional_int(node.get("hot_value")),
+        label=optional_int(node.get("label")),
+        sentence_id=optional_id(node.get("sentence_id")),
+        group_id=optional_id(node.get("group_id")),
+        video_count=optional_int(node.get("video_count")),
+        event_time=epoch_to_datetime(node.get("event_time")),
+        cover=image_from_url_list(node.get("word_cover")),
+        raw=node.raw(),
+    )
+
+
+def parse_hot_search(payload: Mapping[str, Any]) -> HotSearchBoard:
+    """Parse ``/aweme/v1/web/hot/search/list/``."""
+    root = _guard(payload)
+    board = root.child("data")
+    return HotSearchBoard(
+        platform=_PLATFORM,
+        active_time=optional_str(board.get("active_time")),
+        items=[_hot_word(node, index) for index, node in enumerate(board.children("word_list"))],
+        trending=[
+            _hot_word(node, index) for index, node in enumerate(board.opt_children("trending_list"))
+        ],
+    )
