+        "query_correct_type": "1",
+        "is_filter_search": "1" if filtered else "0",
+        "from_group_id": "",
+        "offset": str(offset),
+        "count": str(count),
+        "need_filter_settings": "1",
+        "list_type": "multi",
+        "search_id": search_id,
+    }
+    if filtered:
+        params["filter_selected"] = json.dumps(
+            {"sort_type": str(sort), "publish_time": str(window)}, separators=(",", ":")
+        )
+    return params
+
