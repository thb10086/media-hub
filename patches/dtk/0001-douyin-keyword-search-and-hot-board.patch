+def hot_search_params(*, profile: ClientProfile = DEFAULT_PROFILE) -> dict[str, str]:
+    """Parameters for ``/aweme/v1/web/hot/search/list/``: the base set only, as V4 sent it."""
+    return base_params(profile)
