# media-hub 部署配置。deploy.sh 首次运行时复制为 deploy/.env，并把 __GENERATE__ 替换为随机值。
# deploy/.env 含密钥：权限 600，不要提交到 git。修改后执行 deploy/deploy.sh up 生效。

# ---- 密钥（自动生成）----
HUB_POSTGRES_PASSWORD=__GENERATE__
HUB_REDIS_PASSWORD=__GENERATE__
# 管理接口 /api/v1/admin/* 的令牌，请求头 X-Admin-Token
HUB_ADMIN_TOKEN=__GENERATE__
# 租户未单独设置回调密钥时使用的全局 HMAC 密钥
HUB_WEBHOOK_SECRET=__GENERATE__

# ---- 抖音数据（DTK）----
# 在 DTK 控制台创建 API Key（scope：douyin:read、media:read、media:write）后填写两项，再执行 deploy.sh up。
# 留空时抖音数据接口返回 501 NOT_CONFIGURED，其余功能不受影响。
HUB_DTK_BASE_URL=
HUB_DTK_API_KEY=

# ---- 对外暴露 ----
# 无域名阶段：直接暴露 8080，并在云安全组里只放行产品后端的出口 IP。
HUB_BIND_HOST=0.0.0.0
HUB_BIND_PORT=8080
# 有备案域名后：填写域名并以 --profile tls 启动 Caddy（deploy.sh 检测到该值会自动启用），
# 同时把 HUB_BIND_HOST 改为 127.0.0.1，HUB_TRUSTED_PROXIES 改为 ["172.30.10.10/32"]。
HUB_DOMAIN=
HUB_TRUSTED_PROXIES=
# 生产环境对接完成后建议改为 false，接口文档改用 docs/API.md 与导出的 openapi.json。
HUB_EXPOSE_DOCS=true

# ---- 与同机其他服务共存 ----
# DTK 控制台只监听 127.0.0.1，通过 SSH 隧道访问；换一个本机未占用的端口即可。
DTK_CONSOLE_PORT=8000
# DTK 的 Redis 缓存上限；小内存机器调低。
DTK_REDIS_MAXMEMORY=160mb
# hub-edge 网络网段，须避开宿主机已有的 Docker 网络与内网网段。
HUB_EDGE_SUBNET=172.30.10.0/24
# SAU（发布用无头浏览器）的内存与 CPU 上限。
HUB_SAU_MEM_LIMIT=1280m
HUB_SAU_CPUS=1.0

# ---- 限流、上传与并发 ----
HUB_DEFAULT_RATE_LIMIT_PER_MIN=120
HUB_MAX_UPLOAD_MB=500
HUB_WEB_CONCURRENCY=2
# 发布任务并发。4G 机器保持 1：每个发布会启动一个无头浏览器。
HUB_WORKER_CONCURRENCY=1
# 定时发布使用的时区（POSIX 格式，CST-8 即北京时间 UTC+8）
HUB_PUBLISH_TZ=CST-8

# ---- 热度排序权重（sort=heat 时的综合分）----
HUB_HEAT_LIKE_WEIGHT=1.0
HUB_HEAT_COMMENT_WEIGHT=3.0
HUB_HEAT_SHARE_WEIGHT=5.0
HUB_HEAT_COLLECT_WEIGHT=4.0
HUB_HEAT_PLAY_WEIGHT=0.0
HUB_HEAT_HALF_LIFE_HOURS=72

# ---- 视频号数据 provider：none | mock（商业数据供应商接入后在此切换）----
HUB_CHANNELS_PROVIDER=none

# ---- 开放扫码绑定与发布的平台（JSON 数组）----
# 可选：douyin、channels、kuaishou、xiaohongshu（后两者发布驱动已具备，启用前请先用测试账号验证）
HUB_PUBLISH_PLATFORMS=["douyin","channels"]

# ---- 出站代理（仅用于回调投递与 video_url 下载），如 http://127.0.0.1:7890 ----
HUB_OUTBOUND_PROXY=

HUB_LOG_LEVEL=INFO

# ---- 构建镜像时的 pip 源（国内服务器可改为 https://mirrors.aliyun.com/pypi/simple/）----
PIP_INDEX_URL=https://pypi.org/simple
